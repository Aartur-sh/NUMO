{
  "name": "numo-radio",
  "private": true,
  "version": "0.3.3",
  "description": "NUMO Radio - Modern Electronic & Ambient Live Stream",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --platform=node --format=esm --outfile=server.js --packages=external",
