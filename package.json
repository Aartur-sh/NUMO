    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "hls.js": "^1.5.18",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.0.0",
